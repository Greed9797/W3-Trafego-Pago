# Frontend
VITE_META_PIXEL_ID=

# Supabase — use the service role only in Vercel server functions.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_KEY=
# Accepted aliases for existing Supabase projects:
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Cron and approval. Generate independent, high-entropy values.
CRON_SECRET=
AUTOBLOG_ADMIN_TOKEN=

# Optional OpenAI-compatible Chat Completions enrichment.
# false keeps deterministic, source-linked drafts and has no model cost.
AUTOBLOG_LLM_ENABLED=false
AUTOBLOG_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
AUTOBLOG_LLM_API_KEY=
AUTOBLOG_LLM_MODEL=gpt-4o-mini

# Optional JSON array of custom RSS/Atom sources. Defaults are documented in docs/AUTOBLOG.md.
AUTOBLOG_FEEDS=
